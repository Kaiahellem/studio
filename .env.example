# Copy to .env.local. For local development, `pnpm db:env` prints the Supabase values.

# Public (inlined into the browser bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Email. Not needed locally: everything is caught by Mailpit (http://127.0.0.1:54324).
RESEND_API_KEY=
EMAIL_FROM="Studio <hei@ditt-domene.no>"

# Local only: notification emails go to Mailpit when RESEND_API_KEY is empty.
MAILPIT_URL=http://127.0.0.1:54324

# Vercel Cron. At least 16 random characters.
CRON_SECRET=

# Website analysis: optional PageSpeed Insights key (works without one at low volume).
PAGESPEED_API_KEY=

# Seed script only
SEED_ADMIN_EMAIL=
