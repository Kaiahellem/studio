{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:all": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "supabase status -o env",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts.tmp && mv src/lib/db/types.ts.tmp src/lib/db/types.ts",
    "seed": "node --experimental-strip-types --env-file=.env.local scripts/seed-demo.mts",
    "test:e2e": "playwright test",
    "db:clean": "node --experimental-strip-types --env-file=.env.local scripts/clean-test-data.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.16.1"
}
